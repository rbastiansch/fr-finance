TZ=UTC
NODE_ENV=production
HOST=0.0.0.0
PORT=3334
LOG_LEVEL=info

# Generate a unique value, for example: node ace generate:key
APP_KEY=replace-with-a-long-random-secret
APP_URL=https://graphql.example.com
GRAPHQL_HOSTNAME=graphql.example.com

SESSION_DRIVER=cookie

# PostgreSQL runs in the production Compose stack. The Compose file creates
# DATABASE_URL using these values and the internal fr-db service name.
# Use a URL-safe password, for example the output of: openssl rand -hex 24
POSTGRES_USER=fr_finance
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_DB=fr_finance

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=https://app.example.com
